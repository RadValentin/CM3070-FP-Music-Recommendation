# Paths to where AcousticBrainz dataset files were unzipped.
# Archives can be downloaded from here: https://acousticbrainz.org/download
AB_HIGHLEVEL_ROOT=D:/Datasets/AcousticBrainz/High-level
AB_SAMPLE_ROOT=D:/Datasets/AcousticBrainz/Sample

# PostgreSQL settings
DATABASE_URL=postgresql://user:password@yourhost:25060/yourdb

# Django settings
DJANGO_SECRET_KEY="django-secret-key"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# External API keys
YOUTUBE_API_KEY="youtube-api-key"